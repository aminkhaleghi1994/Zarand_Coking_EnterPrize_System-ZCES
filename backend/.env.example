# ZCES backend configuration template.
# Copy to .env and fill values. NEVER commit .env. Never hardcode these values in code.

# --- Application (Phase 1) ---
APP_ENV=development
APP_NAME=ZCES
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Database (Phase 1) ---
# Either provide DATABASE_URL directly, or all DATABASE_* parts below.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=zces_dev
DATABASE_USER=zces_user
DATABASE_PASSWORD=change_me
# DATABASE_URL=postgresql+psycopg://zces_user:change_me@127.0.0.1:5432/zces_dev

# --- CORS (Phase 1) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Redis (reserved for later phases; not used in Phase 1) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6379/0

# --- JWT / Auth (reserved for Phase 2; not used in Phase 1) ---
JWT_SECRET_KEY=change_me_secure_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax

# --- Initial seed admin (reserved for Phase 3) ---
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_me_now

# --- Observability (reserved for Phase 10) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
