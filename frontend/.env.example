# ZCES frontend configuration template.
# Copy to .env.local and fill values. NEVER commit .env.local.

NEXT_PUBLIC_APP_NAME=ZCES
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Server-side base URL of the FastAPI backend (BFF proxy target).
BACKEND_API_BASE_URL=http://127.0.0.1:8000/api/v1

NEXT_PUBLIC_DEFAULT_LOCALE=en
